# ==============================================================================
# SYNERGY - Master Environment Configuration Template
# A CrossTech Solutions Product
# ==============================================================================

# Application Environments
NODE_ENV=development
APP_NAME=Synergy
APP_ENV=local
PORT=4000
WEB_PORT=3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Configuration (PostgreSQL in production; SQLite or PostgreSQL in local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/synergy_db?schema=public"
# For local zero-dependency fallback:
# DATABASE_URL="file:./dev.db"

# Upstash Redis & Queue Configuration
# Option A: Upstash Serverless REST (Recommended for serverless & cloud)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Option B: Standard Redis / TLS Connection String (e.g. rediss://default:token@xxx.upstash.io:6379)
REDIS_URL=

# Authentication & JWT Secrets
JWT_SECRET=super_secret_synergy_jwt_signing_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# AI Provider Credentials (Configurable per tenant / global fallback)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
REPLICATE_API_TOKEN=

# Social Media API Credentials (OAuth 2.0)
# Instagram / Meta Graph API
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4000/api/v1/auth/social/instagram/callback

# LinkedIn Marketing & Community Management API
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:4000/api/v1/auth/social/linkedin/callback

# X (Twitter) Developer API v2
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:4000/api/v1/auth/social/x/callback

# Object Storage (S3 / MinIO / Local)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=synergy-media
S3_ACCESS_KEY=
S3_SECRET_KEY=

